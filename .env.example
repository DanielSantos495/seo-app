# ============================================================
# .env.example — variables requeridas para correr la app
# ============================================================
# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore — JAMÁS commitear secretos.
# ============================================================

# --- Shopify ---
# Partner Dashboard → tu app → Configuration → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Scopes solicitados a la Admin API. Debe coincidir con shopify.app.toml.
SCOPES=read_products,write_products

# URL pública del deploy (la asigna Railway al crear el servicio).
# En dev la setea automáticamente el túnel del Shopify CLI.
SHOPIFY_APP_URL=

# --- Database ---
# En dev: Postgres local con Docker → `pnpm db:up` (ver docker-compose.yml).
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cury_seo_dev"
# En prod: Railway managed Postgres (var ${{Postgres.DATABASE_URL}}).
DATABASE_URL=

# --- Billing ---
# false en prod (Shopify cobra de verdad).
# true en dev (Shopify simula los cobros sin cargar la tarjeta del merchant).
BILLING_TEST=false

# --- Runtime ---
# development en local, production en Railway.
NODE_ENV=development

# Railway inyecta PORT dinámicamente. 3000 es el default para dev local.
PORT=3000
