// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// Cache del último análisis SEO completo por tienda.
// `data` guarda el JSON serializado (SQLite no soporta el tipo Json nativo;
// al migrar a PostgreSQL en prod podemos cambiarlo a `Json`).
model SeoCache {
  id        String   @id @default(cuid())
  shop      String   @unique
  data      String
  updatedAt DateTime @updatedAt
}

// Estado de jobs en background (análisis SEO completo, bulk fix de alt texts).
// El loader consulta el job activo del shop para mostrar progreso sin bloquear
// la respuesta. Persistimos `processed`/`total` y un heartbeat para resiliencia:
// si el proceso reinicia, el siguiente loader detecta un job con
// `lastHeartbeatAt` antiguo y lo marca `failed` para que se pueda re-arrancar.
//
// `type` discrimina jobs:
//   - "analysis"   → fetch full + analyze + setCachedItems
//   - "bulk_alt"   → bulk fix de alt texts
//
// `payload` guarda info específica del job (ej. gids elegibles del bulk fix).
// `resultSummary` guarda el resumen al terminar (ej. {totalImages, errors}).
model SeoJob {
  id              String    @id @default(cuid())
  shop            String
  type            String
  status          String    @default("pending") // pending | running | done | failed
  processed       Int       @default(0)
  total           Int       @default(0)
  payload         String?
  resultSummary   String?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?

  @@index([shop, status])
  @@index([shop, type, status])
}

// Configuración del merchant para la generación de contenido con IA.
// `brandContext` = texto libre (voz de marca, industria, audiencia, etc.).
model ShopSettings {
  id           String   @id @default(cuid())
  shop         String   @unique
  brandContext String   @default("")
  updatedAt    DateTime @updatedAt
}

// Consumo mensual de features de IA por tienda. `period` = "YYYY-MM" (UTC).
// Una fila por shop+mes; se hace upsert/increment al consumir.
model AiUsage {
  id        String   @id @default(cuid())
  shop      String
  period    String   // "YYYY-MM"
  aiAlt     Int      @default(0)
  aiMeta    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([shop, period])
  @@index([shop])
}
